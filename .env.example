# Server-side Base API URL
# The URL where the Next.js API Routes and Server Components will contact the frozen backend.
API_BASE_URL=https://logistics-backend-jyz7.onrender.com/api/v1

# Client-side / Application Base URL
# The URL for browser returns, Stripe webhooks, or absolute front-end links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Credentials
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer@example.com
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=password123
NEXT_PUBLIC_DEMO_COURIER_EMAIL=courier@example.com
NEXT_PUBLIC_DEMO_COURIER_PASSWORD=password123
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=password123

# Session Secret (Required for production)
# Generate a secure 32+ character string for signing JWT/session cookies.
SESSION_SECRET=your-32-character-super-secret-key
